# =========================================================
# リアルタイムAI議事録ツール 環境設定サンプル
# このファイルを .env にコピーして値を書き換えてください
# =========================================================

# --- デバイス設定 ---
# Whisper(文字起こし)を実行するデバイス。 "cuda" または "cpu"
WHISPER_DEVICE=cuda
# Whisperの計算精度。GPU: "int8_float16" or "float16" / CPU: "int8"
WHISPER_COMPUTE_TYPE=int8_float16
# Whisperモデル名 (faster-whisper / CTranslate2形式)
WHISPER_MODEL=large-v3-turbo

# pyannote(話者分離)を実行するデバイス。 "cuda" または "cpu"
# RTX 2070(8GB)でOOMが出る場合は "cpu" に変更してください
DIARIZATION_DEVICE=cuda
# pyannoteのHuggingFaceアクセストークン(speaker-diarization-community-1の利用に必要)
# https://hf.co/settings/tokens で発行し、モデルページの利用規約に同意しておくこと
HF_TOKEN=

# Embeddingのバッチサイズ。VRAMが厳しい場合は小さくする(既知のVRAM急増対策)
DIARIZATION_EMBEDDING_BATCH_SIZE=4

# --- Ollama / Qwen3 ---
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen3:4b-instruct-2507-q4_K_M

# --- 音声チャンク設定 ---
# 何秒ごとに音声をチャンク化してAI処理へ渡すか
AUDIO_CHUNK_SECONDS=8
# チャンクの録音サンプルレート(WASAPIから取得した後、Whisper用に16kHzへリサンプルする)
AUDIO_TARGET_SAMPLE_RATE=16000

# --- 議事録の差分更新設定 ---
# 何文字分の新規Corrected Transcriptが蓄積したら議事録を更新するか
MINUTES_UPDATE_CHAR_THRESHOLD=800
# 何秒ごとに議事録更新を試みるか(文字数閾値未満でも一定時間ごとに更新する)
MINUTES_UPDATE_INTERVAL_SECONDS=180

# --- 話者クラスタリング設定 ---
# 話者embeddingのコサイン距離がこの値未満なら同一話者とみなす(小さいほど厳しい)
SPEAKER_SIMILARITY_THRESHOLD=0.45

# --- データベース ---
DATABASE_URL=sqlite:///./data/meeting_ai.db

# --- ログ ---
LOG_LEVEL=INFO
